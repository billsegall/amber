# Copy this to .env and fill in your values

# Amber Electric API
AMBER_API_TOKEN=psk_your_token_here
AMBER_SITE_ID=                        # leave blank to auto-discover

# Flask
FLASK_SECRET_KEY=change_me_to_a_random_string
FLASK_ENV=development

# FOX ESS battery (Stage 4) — generate key at foxesscloud.com dashboard
FOXESS_API_KEY=
FOXESS_DEVICE_SN=

# Fronius solar local API (Stage 4) — IP of inverter on your LAN
FRONIUS_IP=

# Signal notifications via CallMeBot (Stage 3)
# Setup: add +34 644 52 74 88 on Signal, send "I allow callmebot to send me messages"
SIGNAL_PHONE=
SIGNAL_CALLMEBOT_APIKEY=
